---
import MagnifyingGlass from '@phosphor-icons/core/assets/regular/magnifying-glass.svg';
import Docs from '../../layouts/Docs.astro';
import StatusChip from '../../components/StatusChip.astro';
import { getDocSections } from '../../lib/docs.ts';

const sections = await getDocSections();
const total = sections.reduce((n, s) => n + s.docs.length, 0);
---

<Docs
	title="Documentation"
	description="Guides, architecture notes and internals for Eulix, generated from the docs folder of the repository."
	sections={sections}
>
	<header class="intro">
		<h1>Documentation</h1>
		<p>
			Every page here is rendered from the <code>docs/</code> folder of the repository, so it stays in step with the
			code. {total} documents in {sections.length} sections.
		</p>
	</header>

	<div class="filter">
		<label for="doc-filter">Filter documents</label>
		<div class="field">
			<MagnifyingGlass width={18} height={18} aria-hidden="true" />
			<input id="doc-filter" type="search" autocomplete="off" spellcheck="false" placeholder="prism, cache, embeddings…" />
		</div>
		<p class="empty" hidden role="status">No document title or summary matches that filter.</p>
	</div>

	{
		sections.map((section) => (
			<section class="group" data-group aria-labelledby={`group-${section.key || 'general'}`}>
				<h2 id={`group-${section.key || 'general'}`}>
					{section.label}
					<span class="count">{section.docs.length}</span>
					{section.component && (
						<StatusChip
							status={section.component.status}
							version={section.component.versionText ? `v${section.component.versionText}` : undefined}
							size="sm"
						/>
					)}
				</h2>
				<ul class="cards">
					{section.docs.map((doc) => (
						<li data-doc data-search={`${doc.title} ${doc.description ?? ''} ${doc.fileName}`.toLowerCase()}>
							<a href={doc.href}>
								<span class="title">{doc.title}</span>
								{doc.description && <span class="desc">{doc.description}</span>}
								<span class="path">{doc.repoPath}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</Docs>

<script>
	const input = document.querySelector<HTMLInputElement>('#doc-filter');
	const empty = document.querySelector<HTMLElement>('.filter .empty');
	input?.addEventListener('input', () => {
		const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
		let shown = 0;
		document.querySelectorAll<HTMLElement>('[data-group]').forEach((group) => {
			let groupShown = 0;
			group.querySelectorAll<HTMLElement>('[data-doc]').forEach((item) => {
				const match = terms.every((t) => item.dataset.search?.includes(t));
				item.hidden = !match;
				if (match) groupShown++;
			});
			group.hidden = groupShown === 0;
			shown += groupShown;
		});
		if (empty) empty.hidden = shown > 0;
	});
</script>

<style>
	.intro h1 {
		font-size: clamp(2.2rem, 1.6rem + 2vw, 3rem);
		letter-spacing: -0.035em;
	}

	.intro p {
		margin-top: 14px;
		max-width: 62ch;
		color: var(--text-2);
	}

	.intro code {
		padding: 0.1em 0.35em;
		border: 1px solid var(--line);
		border-radius: 5px;
		background: var(--bg-raised);
		color: var(--gold);
		font-size: 0.88em;
	}

	.filter {
		margin-top: 32px;
		max-width: 520px;
	}

	.filter label {
		display: block;
		margin-bottom: 8px;
		font-size: 0.85rem;
		color: var(--text-2);
	}

	.field {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 0 14px;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-control);
		background: var(--bg-inset);
		color: var(--muted);
		transition: border-color 160ms var(--ease-out);
	}

	.field:focus-within {
		border-color: var(--teal);
	}

	input {
		flex: 1;
		min-width: 0;
		min-height: 44px;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--text);
		font: inherit;
		font-size: 0.95rem;
	}

	input::placeholder {
		color: var(--muted);
	}

	.empty {
		margin-top: 16px;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.group {
		margin-top: 48px;
	}

	.group h2 {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
		font-size: 1.15rem;
		letter-spacing: -0.015em;
	}

	.count {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		color: var(--muted);
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 12px;
		margin: 16px 0 0;
		padding: 0;
		list-style: none;
	}

	.cards a {
		display: flex;
		flex-direction: column;
		gap: 8px;
		height: 100%;
		padding: 18px 20px;
		border: 1px solid var(--line);
		border-radius: var(--radius-panel);
		background: var(--bg-raised);
		text-decoration: none;
		transition:
			border-color 160ms var(--ease-out),
			background-color 160ms var(--ease-out);
	}

	.title {
		color: var(--text);
		font-weight: 600;
		line-height: 1.35;
	}

	.desc {
		color: var(--muted);
		font-size: 0.88rem;
		line-height: 1.55;
	}

	.path {
		margin-top: auto;
		padding-top: 6px;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--faint);
		overflow-wrap: anywhere;
	}

	@media (hover: hover) and (pointer: fine) {
		.cards a:hover {
			border-color: var(--teal-line);
			background: var(--bg-panel);
		}
		.cards a:hover .title {
			color: var(--teal);
		}
	}
</style>
