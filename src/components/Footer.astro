---
import { HUBS } from '../data/hubs.ts';
import { withBase } from '../lib/doc-paths.ts';
import { docUrl } from '../lib/docs.ts';
import { FIRST_DOC, SITE } from '../site.config.ts';
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL;
const home = withBase(base, '');
const year = new Date().getFullYear();

const columns = [
	{
		title: 'Product',
		links: [
			{ label: 'Install', href: `${home}#install` },
			{ label: 'How it works', href: `${home}#how-it-works` },
			{ label: 'Benchmarks', href: `${home}#benchmarks` },
			{ label: 'Ecosystem', href: `${home}#ecosystem` },
		],
	},
	{
		title: 'Inside Eulix',
		links: HUBS.map((h) => ({ label: h.name, href: withBase(base, `${h.slug}/`) })),
	},
	{
		title: 'Docs',
		links: [
			{ label: 'About Eulix', href: await docUrl(FIRST_DOC) },
			{ label: 'Installation', href: await docUrl('installation') },
			{ label: 'Known issues', href: await docUrl('known-issues/overview') },
			{ label: 'All docs', href: withBase(base, 'docs/') },
		],
	},
	{
		title: 'Project',
		links: [
			{ label: 'GitHub', href: SITE.repoUrl },
			{ label: 'Issues', href: `${SITE.repoUrl}/issues` },
			{ label: 'libeulix on crates.io', href: SITE.crateUrl },
			{ label: 'DeepWiki', href: SITE.deepWikiUrl },
		],
	},
];
---

<footer class="site-footer">
	<div class="container grid">
		<div class="brand">
			<Logo href={home} />
			<p>{SITE.tagline}.</p>
		</div>
		{
			columns.map((col) => (
				<nav aria-label={col.title}>
					<h2>{col.title}</h2>
					<ul>
						{col.links.map((link) => (
							<li>
								<a href={link.href}>{link.label === 'About Eulix' ? <>About <span class="eulix spaced">Eulix</span></> : link.label}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>
	<div class="container legal">
		<p>© 2025–{year} {SITE.author}</p>
		<p>
			Licensed under <a href={`${SITE.repoUrl}/blob/${SITE.branch}/LICENSE`}>{SITE.license}</a>
		</p>
		<p>
			Display type: <a href="https://www.redaction.us/">Redaction</a> by MCKL
		</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		padding-block: 56px 32px;
		background: var(--bg);
	}

	.grid {
		display: grid;
		grid-template-columns: 1.6fr repeat(4, 1fr);
		gap: 32px;
	}

	.brand p {
		margin-top: 8px;
		max-width: 30ch;
		color: var(--muted);
		font-size: 0.92rem;
	}

	h2 {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--muted);
	}

	ul {
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 2px;
	}

	a {
		display: inline-flex;
		align-items: center;
		min-height: 32px;
		color: var(--text-2);
		font-size: 0.92rem;
		text-decoration: none;
	}

	@media (hover: hover) and (pointer: fine) {
		a:hover {
			color: var(--teal);
		}
	}

	.legal {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 24px;
		margin-top: 48px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
		color: var(--faint);
		font-size: 0.85rem;
	}

	.legal a {
		display: inline;
		font-size: inherit;
		color: var(--muted);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 860px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.brand {
			grid-column: 1 / -1;
		}
	}
</style>
