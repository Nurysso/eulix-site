---
import type { ComponentStatus } from '../site.config.ts';

interface Props {
	status: ComponentStatus;
	/** e.g. `v0.9.0`; omitted when unknown. */
	version?: string;
	size?: 'sm' | 'md';
}

const { status, version, size = 'md' } = Astro.props;
---

<span class:list={['status', `status-${status}`, `status-${size}`]}>
	<span class="status-dot" aria-hidden="true"></span>
	<span class="status-label">{status}</span>
	{version && <span class="status-version">{version}</span>}
</span>
