---
import GithubLogo from '@phosphor-icons/core/assets/regular/github-logo.svg';
import { withBase } from '../lib/doc-paths.ts';
import { SITE } from '../site.config.ts';
import Logo from './Logo.astro';

interface Props {
	/** Which top-level area is active, for aria-current. */
	current?: 'home' | 'docs';
}

const { current = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = withBase(base, '');
---

<header class="site-header">
	<div class="container bar">
		<Logo href={home} />
		<nav aria-label="Main">
			<ul>
				<li class="wide-only"><a href={`${home}#how-it-works`}>How it works</a></li>
				<li class="wide-only"><a href={`${home}#engines`}>Engines</a></li>
				<li class="wide-only"><a href={`${home}#benchmarks`}>Benchmarks</a></li>
				<li>
					<a href={withBase(base, 'docs/')} aria-current={current === 'docs' ? 'true' : undefined}>Docs</a>
				</li>
				<li>
					<a class="gh" href={SITE.repoUrl} rel="noopener">
						<GithubLogo width={18} height={18} aria-hidden="true" />
						<span>GitHub</span>
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		height: var(--header-h);
		border-bottom: 1px solid var(--line);
		background: rgb(10 11 14 / 0.78);
		backdrop-filter: saturate(140%) blur(12px);
		-webkit-backdrop-filter: saturate(140%) blur(12px);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		height: 100%;
	}

	ul {
		display: flex;
		align-items: center;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a:not(.logo) {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 12px;
		border-radius: var(--radius-control);
		color: var(--text-2);
		font-size: 0.92rem;
		text-decoration: none;
		transition: color 160ms var(--ease-out);
	}

	a[aria-current] {
		color: var(--text);
	}

	.gh {
		margin-left: 4px;
		border: 1px solid var(--line-strong);
	}

	@media (hover: hover) and (pointer: fine) {
		a:not(.logo):hover {
			color: var(--text);
		}
	}

	@media (max-width: 720px) {
		.wide-only {
			display: none;
		}
	}
</style>
