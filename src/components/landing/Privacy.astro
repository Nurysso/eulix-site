---
import { siOllama } from 'simple-icons';
import BrandIcon from '../BrandIcon.astro';

const local = [
	{ name: 'your source', detail: 'read from your disk' },
	{ name: 'libeulix', detail: 'parse, resolve, index' },
	{ name: 'local query engine', detail: 'exact, lexical, semantic, graph' },
];
---

<section class="section" id="privacy" aria-labelledby="privacy-title">
	<div class="container grid">
		<div class="text">
			<h2 id="privacy-title" class="section-title reveal">Your code stays on your machine.</h2>
			<p class="section-lead reveal">
				Parsing, indexing, retrieval and embedding all run on-device. The LLM stage is optional and cloud providers are
				opt-in. With a local provider such as Ollama, nothing leaves your environment.
			</p>
			<p class="warning reveal">
				<strong>Using a remote provider?</strong> The retrieved code context for each query is sent to it. Choose accordingly
				for proprietary repositories.
			</p>
		</div>

		<div class="diagram reveal" style="--reveal-index: 1" role="img" aria-label="Your source flows into libeulix, then the local query engine, all inside your machine. The optional LLM sits on the boundary: local with Ollama, or a remote provider if you opt in.">
			<div class="machine">
				<span class="machine-label mono">your machine</span>
				{
					local.map((node, i) => (
						<>
							{i > 0 && <span class="link" />}
							<div class="node">
								<span class="mono name">{node.name}</span>
								<span class="detail">{node.detail}</span>
							</div>
						</>
					))
				}
				<span class="link link-dashed"></span>
			</div>
			<div class="node node-llm">
				<span class="mono name">optional LLM</span>
				<span class="detail">
					<BrandIcon icon={siOllama} size={14} /> Ollama locally, or a remote provider you configure
				</span>
			</div>
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		gap: clamp(40px, 6vw, 80px);
		align-items: center;
	}

	.warning {
		margin-top: 28px;
		max-width: 56ch;
		padding: 14px 18px;
		border: 1px solid rgb(251 191 36 / 0.25);
		border-left: 3px solid var(--amber);
		border-radius: 0 var(--radius-control) var(--radius-control) 0;
		background: rgb(251 191 36 / 0.05);
		color: var(--text-2);
		font-size: 0.92rem;
	}

	.warning strong {
		color: var(--amber);
		font-weight: 600;
	}

	.diagram {
		display: flex;
		flex-direction: column;
	}

	.machine {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 36px 24px 0;
		border: 1px solid var(--teal-line);
		border-bottom: 0;
		border-radius: var(--radius-panel) var(--radius-panel) 0 0;
		background:
			linear-gradient(180deg, var(--teal-wash), transparent 85%),
			var(--bg);
	}

	.machine-label {
		position: absolute;
		top: 10px;
		left: 14px;
		font-size: 0.72rem;
		color: var(--teal);
	}

	.node {
		display: grid;
		gap: 2px;
		padding: 12px 16px;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-control);
		background: var(--bg-panel);
	}

	.name {
		color: var(--text);
		font-size: 0.9rem;
	}

	.detail {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--muted);
		font-size: 0.82rem;
	}

	.link {
		width: 1px;
		height: 20px;
		margin-left: 28px;
		background: var(--line-strong);
	}

	.link-dashed {
		height: 28px;
		background: repeating-linear-gradient(180deg, var(--muted) 0 4px, transparent 4px 8px);
	}

	.node-llm {
		border-style: dashed;
		border-color: var(--violet-line);
		border-radius: 0 0 var(--radius-panel) var(--radius-panel);
		background: var(--bg-raised);
	}

	.node-llm .name {
		color: var(--lilac);
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
