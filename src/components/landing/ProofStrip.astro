---
import { siDjango, siFfmpeg, siFirefoxbrowser, siGo, siLinux, siOpenstack } from 'simple-icons';
import BrandIcon from '../BrandIcon.astro';

// From the README's "Validated on" list.
const projects = [
	{ name: 'Linux kernel', icon: siLinux },
	{ name: 'Go compiler', icon: siGo },
	{ name: 'FFmpeg', icon: siFfmpeg },
	{ name: 'Gecko / Firefox', icon: siFirefoxbrowser },
	{ name: 'Django', icon: siDjango },
	{ name: 'OpenStack Nova', icon: siOpenstack },
];
---

<section class="proof" aria-labelledby="proof-title">
	<div class="container row">
		<h2 id="proof-title">Validated on</h2>
		<ul>
			{
				projects.map((project) => (
					<li>
						<BrandIcon icon={project.icon} size={20} />
						<span>{project.name}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.proof {
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		background: var(--bg-raised);
	}

	.row {
		display: flex;
		align-items: center;
		gap: 16px 40px;
		padding-block: 22px;
	}

	h2 {
		flex: none;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 500;
		color: var(--muted);
		letter-spacing: 0.02em;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px 32px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--text-2);
		font-size: 0.92rem;
		white-space: nowrap;
	}

	li :global(svg) {
		color: var(--muted);
	}

	@media (max-width: 760px) {
		.row {
			flex-direction: column;
			align-items: flex-start;
		}
		ul {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 14px 20px;
		}
	}
</style>
