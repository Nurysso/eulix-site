---
import ArrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg';
import Cpu from '@phosphor-icons/core/assets/regular/cpu.svg';
import GithubLogo from '@phosphor-icons/core/assets/regular/github-logo.svg';
import LockSimple from '@phosphor-icons/core/assets/regular/lock-simple.svg';
import TreeStructure from '@phosphor-icons/core/assets/regular/tree-structure.svg';
import { heroGraph, heroQueries } from '../../data/hero-graph.ts';
import { versionOf } from '../../lib/components.ts';
import { withBase } from '../../lib/doc-paths.ts';
import { FIRST_DOC, SITE } from '../../site.config.ts';
import InstallCommand from '../InstallCommand.astro';

const docsHref = withBase(import.meta.env.BASE_URL, `docs/${FIRST_DOC}/`);
const cliVersion = versionOf('eulix-cli');
const { focus, callers, callees } = heroGraph;
const initial = heroQueries[0];
const where = (n: { file: string; line: number }) => `${n.file}:${n.line}`;
const short = (file: string) => file.split('/').at(-1);

const points = [
	{ icon: Cpu, text: 'No embeddings or GPU required (with EHNAS).' },
	{ icon: TreeStructure, text: 'Saves token context by returning structural graph data.' },
	{ icon: LockSimple, text: '100% local. Your code never leaves the machine.' },
];

const answers = {
	location: `${where(focus)}`,
	callers: `${callers.length} caller: ${callers.map((c) => `${c.name} (${where(c)})`).join(', ')}`,
	callees: `${callees.length} callees, all in libeulix/src/analyze/`,
};
---

<section class="hero" aria-labelledby="hero-title">
	<div class="backdrop" aria-hidden="true"></div>
	<div class="container layout">
		<div class="copy">
			<p class="eyebrow hero-in" style="--i: 0">
				{cliVersion && <span class="chip chip-teal">{cliVersion}</span>}
				MCP server and CLI
			</p>
			<h1 id="hero-title" class="hero-in" style="--i: 1">
				<span class="brand" aria-label="Eulix"><span class="r0" aria-hidden="true">E</span><span class="r10" aria-hidden="true">u</span><span class="r50" aria-hidden="true">l</span><span class="r70" aria-hidden="true">i</span><span class="r100" aria-hidden="true">x</span></span>: <span class="r-20 resolve" data-resolve><span class="nowrap">Local-First</span> Retrieval for <span class="nowrap">AI Agents.</span></span>
			</h1>
			<p class="lead hero-in" style="--i: 2">
				<span class="r-35 key">Stop making your agent grep and guess.</span> <span class="eulix">Eulix</span> answers lookups directly from a structural index and returns
				ranked, token-budgeted context for your MCP client.
			</p>
			<ul class="points hero-in" style="--i: 3">
				{
					points.map((p) => (
						<li>
							<p.icon width={18} height={18} aria-hidden="true" />
							<span>{p.text}</span>
						</li>
					))
				}
			</ul>
			<div class="install-block hero-in" style="--i: 4">
				<InstallCommand id="hero-os" />
			</div>
			<div class="links hero-in" style="--i: 5">
				<a class="btn btn-ghost" href={docsHref}>
					Read the docs
					<ArrowRight width={16} height={16} aria-hidden="true" />
				</a>
				<a class="btn btn-ghost" href={SITE.repoUrl} rel="noopener">
					<GithubLogo width={18} height={18} aria-hidden="true" />
					GitHub
				</a>
			</div>
		</div>

		<figure class="demo hero-in" style="--i: 2" aria-labelledby="demo-caption">
			<div class="panel" data-hero-graph data-state={initial.key}>
				<div class="panel-head">
					<span class="prompt" aria-hidden="true">›</span>
					<code class="query" data-query>{initial.query}</code>
					<span class="tags">
						<span class="chip chip-teal" data-route>{initial.route}</span>
						<span class="chip">no LLM</span>
					</span>
				</div>

				<div class="graph" data-graph>
					<svg class="edges" aria-hidden="true" data-edges></svg>
					<ul class="col col-callers" aria-label="Callers">
						{
							callers.map((n) => (
								<li class="node node-caller" data-edge="in" title={where(n)}>
									<span class="name">{n.name}</span>
									<span class="file">{short(n.file)}</span>
								</li>
							))
						}
					</ul>
					<div class="col col-focus">
						<div class="node node-focus" data-focus title={where(focus)}>
							<span class="name">{focus.name}</span>
							<span class="file">{short(focus.file)}</span>
						</div>
					</div>
					<ul class="col col-callees" aria-label="Callees">
						{
							callees.map((n, i) => (
								<li class="node node-callee" data-edge="out" style={`--i: ${i}`} title={where(n)}>
									<span class="name">{n.name}</span>
									{n.tag && <span class="tag">{n.tag}</span>}
								</li>
							))
						}
					</ul>
				</div>

				<div class="panel-foot">
					<p class="answer" aria-live="polite">
						{
							heroQueries.map((q) => (
								<span data-answer={q.key} hidden={q.key !== initial.key}>
									<span class="answer-arrow" aria-hidden="true">→</span> {answers[q.key]}
								</span>
							))
						}
					</p>
					<div class="pager" role="group" aria-label="Example questions">
						{
							heroQueries.map((q, i) => (
								<button
									type="button"
									data-pick={i}
									aria-pressed={q.key === initial.key ? 'true' : 'false'}
									aria-label={q.query}
									title={q.query}
								/>
							))
						}
					</div>
				</div>
			</div>
			<figcaption id="demo-caption">
				Eulix's own call graph: the parser's analysis pipeline. These answers come straight from the index, with no
				model involved.
			</figcaption>
			<script type="application/json" data-hero-queries set:html={JSON.stringify(heroQueries)} />
		</figure>
	</div>
</section>

<script>
	const resolveEl = document.querySelector<HTMLElement>('[data-resolve]');
	if (resolveEl && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const levels = ['Redaction 100', 'Redaction 70', 'Redaction 50', 'Redaction 35', 'Redaction 20'];
		Promise.all(levels.map((f) => document.fonts.load(`700 1em '${f}'`)))
			.then(() => resolveEl.classList.add('is-resolving'))
			.catch(() => {});
	}

	interface HeroQuery {
		key: string;
		query: string;
		route: string;
	}

	const SVG_NS = 'http://www.w3.org/2000/svg';
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function edgePath(from: DOMRect, to: DOMRect, box: DOMRect): string {
		const x = (v: number) => v - box.left;
		const y = (v: number) => v - box.top;
		if (to.left >= from.right - 4) {
			// Side by side: right edge of `from` to left edge of `to`.
			const x0 = x(from.right);
			const y0 = y(from.top + from.height / 2);
			const x1 = x(to.left);
			const y1 = y(to.top + to.height / 2);
			const bend = Math.max(18, (x1 - x0) * 0.55);
			return `M ${x0} ${y0} C ${x0 + bend} ${y0}, ${x1 - bend} ${y1}, ${x1} ${y1}`;
		}
		// Stacked (tree layout): drop down from inside `from`, then turn right into `to`.
		const x0 = x(from.left + 14);
		const y0 = y(from.bottom);
		const x1 = x(to.left);
		const y1 = y(to.top + to.height / 2);
		const r = Math.min(10, Math.max(0, x1 - x0));
		return `M ${x0} ${y0} V ${y1 - r} Q ${x0} ${y1} ${x0 + r} ${y1} H ${x1}`;
	}

	function setupHeroGraph(panel: HTMLElement) {
		const graph = panel.querySelector<HTMLElement>('[data-graph]')!;
		const svg = panel.querySelector<SVGSVGElement>('[data-edges]')!;
		const focus = panel.querySelector<HTMLElement>('[data-focus]')!;
		const queryEl = panel.querySelector<HTMLElement>('[data-query]')!;
		const routeEl = panel.querySelector<HTMLElement>('[data-route]')!;
		const answers = [...panel.querySelectorAll<HTMLElement>('[data-answer]')];
		const picks = [...panel.querySelectorAll<HTMLButtonElement>('[data-pick]')];
		const queries = JSON.parse(
			panel.closest('figure')!.querySelector('[data-hero-queries]')!.textContent ?? '[]',
		) as HeroQuery[];

		const draw = () => {
			const box = graph.getBoundingClientRect();
			svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
			svg.replaceChildren();
			const f = focus.getBoundingClientRect();
			panel.querySelectorAll<HTMLElement>('[data-edge]').forEach((node) => {
				const n = node.getBoundingClientRect();
				const path = document.createElementNS(SVG_NS, 'path');
				const incoming = node.dataset.edge === 'in';
				path.setAttribute('d', incoming ? edgePath(n, f, box) : edgePath(f, n, box));
				path.setAttribute('class', `edge edge-${incoming ? 'in' : 'out'}`);
				path.style.setProperty('--i', node.style.getPropertyValue('--i') || '0');
				svg.append(path);
			});
		};
		draw();
		new ResizeObserver(draw).observe(graph);
		document.fonts?.ready.then(draw);

		let index = 0;
		let typing: number | undefined;
		const show = (next: number) => {
			index = (next + queries.length) % queries.length;
			const q = queries[index];
			panel.dataset.state = q.key;
			routeEl.textContent = q.route;
			answers.forEach((a) => (a.hidden = a.dataset.answer !== q.key));
			picks.forEach((p, i) => p.setAttribute('aria-pressed', String(i === index)));

			window.clearInterval(typing);
			if (reduceMotion) {
				queryEl.textContent = q.query;
				return;
			}
			let shown = 0;
			queryEl.textContent = '';
			panel.classList.add('is-typing');
			typing = window.setInterval(() => {
				shown += 1;
				queryEl.textContent = q.query.slice(0, shown);
				if (shown >= q.query.length) {
					window.clearInterval(typing);
					panel.classList.remove('is-typing');
				}
			}, 28);
		};

		// Rotate through the questions while the panel is visible and nobody is using it.
		let timer: number | undefined;
		let held = false;
		let visible = false;
		const stop = () => {
			window.clearInterval(timer);
			timer = undefined;
		};
		const start = () => {
			if (reduceMotion || held || !visible || timer !== undefined) return;
			timer = window.setInterval(() => show(index + 1), 4200);
		};
		picks.forEach((pick, i) =>
			pick.addEventListener('click', () => {
				held = true;
				stop();
				show(i);
			}),
		);
		panel.addEventListener('pointerenter', stop);
		panel.addEventListener('pointerleave', start);
		panel.addEventListener('focusin', stop);
		panel.addEventListener('focusout', start);
		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			if (visible) start();
			else stop();
		}).observe(panel);
		document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
	}

	document.querySelectorAll<HTMLElement>('[data-hero-graph]').forEach(setupHeroGraph);
</script>

<style>

	.hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(48px, 7vw, 88px) clamp(56px, 7vw, 96px);
	}

	.backdrop {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(ellipse 50% 60% at 78% 45%, rgb(94 234 212 / 0.07), transparent 70%),
			radial-gradient(rgb(231 233 238 / 0.07) 1px, transparent 1px) 0 0 / 22px 22px;
		mask-image: radial-gradient(ellipse 85% 75% at 60% 35%, #000 0%, transparent 78%);
		-webkit-mask-image: radial-gradient(ellipse 85% 75% at 60% 35%, #000 0%, transparent 78%);
	}

	.layout {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 620px);
		gap: clamp(32px, 4vw, 56px);
		align-items: center;
	}

	h1 {
		margin-top: 18px;
		max-width: 14ch;
		font-size: clamp(2.7rem, 1.4rem + 3.6vw, 4.4rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1;
	}

	.brand {
		color: var(--teal);
		font-weight: 700;
		letter-spacing: 0;
	}

	/* Redaction (OFL 1.1 / LGPL 2.1), see src/fonts/redaction/OFL.txt */
	.r0 { font-family: 'Redaction', serif; }
	.r10 { font-family: 'Redaction 10', serif; }
	.r50 { font-family: 'Redaction 50', serif; }
	.r70 { font-family: 'Redaction 70', serif; }
	.r100 { font-family: 'Redaction 100', serif; }

	.nowrap {
		white-space: nowrap;
	}

	.lead {
		margin-top: 20px;
		max-width: 48ch;
		color: var(--text-2);
		font-size: clamp(1.02rem, 0.97rem + 0.25vw, 1.15rem);
		line-height: 1.6;
	}

	.points {
		display: grid;
		gap: 9px;
		margin: 22px 0 0;
		padding: 0;
		list-style: none;
	}

	.points li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		color: var(--text);
		font-size: 0.97rem;
		line-height: 1.45;
	}

	.points :global(svg) {
		flex: none;
		margin-top: 1px;
		color: var(--teal);
	}

	.install-block {
		margin-top: 26px;
		max-width: 560px;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 16px;
	}

	/* ── Call-graph demo ── */

	.demo {
		margin: 0;
	}

	.panel {
		container: graph / inline-size;
		border: 1px solid var(--line-strong);
		border-radius: 14px;
		background: linear-gradient(180deg, rgb(255 255 255 / 0.025), transparent 40%), var(--bg-raised);
		box-shadow:
			0 40px 120px -50px rgb(94 234 212 / 0.25),
			0 24px 60px -30px rgb(0 0 0 / 0.8);
		overflow: hidden;
	}

	.panel-head {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 52px;
		padding: 10px 16px;
		border-bottom: 1px solid var(--line);
		background: var(--bg-inset);
		font-family: var(--font-mono);
	}

	.prompt {
		color: var(--teal);
	}

	.query {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		color: var(--text);
		font-size: 0.86rem;
	}

	.is-typing .query::after {
		content: '';
		display: inline-block;
		width: 7px;
		height: 1.05em;
		margin-left: 2px;
		vertical-align: -0.15em;
		background: var(--teal);
	}

	.tags {
		display: inline-flex;
		gap: 6px;
		flex: none;
	}

	.graph {
		position: relative;
		display: grid;
		grid-template-columns: auto auto minmax(0, 1fr);
		grid-template-areas: 'callers focus callees';
		align-items: center;
		column-gap: 48px;
		padding: 22px 20px;
	}

	.edges {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.edges :global(.edge) {
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 1.25;
		transition:
			stroke 300ms var(--ease-out),
			opacity 300ms var(--ease-out);
	}

	.col {
		position: relative;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.col-callers {
		grid-area: callers;
	}
	.col-focus {
		grid-area: focus;
	}
	.col-callees {
		grid-area: callees;
		display: grid;
		gap: 7px;
		justify-items: start;
	}

	.node {
		display: inline-flex;
		align-items: baseline;
		gap: 8px;
		padding: 6px 10px;
		border: 1px solid var(--line-strong);
		border-radius: 7px;
		background: var(--bg-panel);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		line-height: 1.35;
		color: var(--text-2);
		white-space: nowrap;
		transition:
			color 300ms var(--ease-out),
			border-color 300ms var(--ease-out),
			background-color 300ms var(--ease-out),
			opacity 300ms var(--ease-out),
			box-shadow 300ms var(--ease-out);
		transition-delay: calc(var(--i, 0) * 45ms);
	}

	.node-caller,
	.node-focus {
		flex-direction: column;
		gap: 1px;
	}

	.node-focus {
		padding: 9px 12px;
		border-color: var(--violet-line);
		color: var(--text);
		font-size: 0.8rem;
	}

	.file {
		color: var(--faint);
		font-size: 0.68rem;
	}

	.tag {
		padding: 0 5px;
		border: 1px solid var(--line-strong);
		border-radius: 4px;
		color: var(--muted);
		font-size: 0.62rem;
	}

	/* Answer highlighting per question. */
	.panel[data-state='callers'] .node-callee,
	.panel[data-state='callees'] .node-caller,
	.panel[data-state='location'] :is(.node-caller, .node-callee) {
		opacity: 0.45;
	}

	.panel[data-state='location'] .edges :global(.edge),
	.panel[data-state='callers'] .edges :global(.edge-out),
	.panel[data-state='callees'] .edges :global(.edge-in) {
		opacity: 0.35;
	}

	.panel[data-state='callers'] .node-caller,
	.panel[data-state='callees'] .node-callee,
	.panel[data-state='location'] .node-focus {
		border-color: var(--teal-line);
		background: rgb(94 234 212 / 0.09);
		color: var(--text);
		box-shadow: 0 0 0 3px rgb(94 234 212 / 0.07);
	}

	.panel[data-state='location'] .node-focus .file {
		color: var(--teal);
	}

	.panel[data-state='callers'] .edges :global(.edge-in),
	.panel[data-state='callees'] .edges :global(.edge-out) {
		stroke: var(--teal);
		stroke-dasharray: 4 5;
		animation: flow 900ms linear infinite;
	}

	@keyframes flow {
		to {
			stroke-dashoffset: -18;
		}
	}

	.panel-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 12px 16px;
		border-top: 1px solid var(--line);
		background: var(--bg-inset);
	}

	.answer {
		min-width: 0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text-2);
		overflow-wrap: anywhere;
	}

	.answer-arrow {
		color: var(--teal);
	}

	.pager {
		display: flex;
		flex: none;
	}

	.pager button {
		position: relative;
		width: 28px;
		height: 28px;
		border: 0;
		background: transparent;
		cursor: pointer;
	}

	.pager button::after {
		content: '';
		position: absolute;
		inset: 0;
		margin: auto;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--line-strong);
		transition:
			background-color 200ms var(--ease-out),
			width 200ms var(--ease-out);
	}

	.pager button[aria-pressed='true']::after {
		width: 18px;
		border-radius: 4px;
		background: var(--teal);
	}

	figcaption {
		margin-top: 12px;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.5;
	}

	/* Narrow panel: an indented tree, caller → function → callees. */
	@container graph (max-width: 560px) {
		.graph {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				'callers'
				'focus'
				'callees';
			align-items: start;
			justify-items: start;
			row-gap: 14px;
			padding: 18px 16px;
		}
		.col-focus {
			padding-left: 28px;
		}
		.col-callees {
			padding-left: 56px;
			gap: 6px;
		}
		.node {
			font-size: 0.7rem;
		}
		.node-focus {
			font-size: 0.76rem;
		}
	}

	@media (max-width: 1100px) {
		.layout {
			grid-template-columns: minmax(0, 1fr);
		}
		h1 {
			max-width: 18ch;
		}
		.demo {
			max-width: 640px;
		}
	}

	@media (max-width: 480px) {
		.panel-head {
			flex-wrap: wrap;
		}
		.query {
			flex-basis: calc(100% - 24px);
		}
		.tags {
			margin-left: 20px;
		}
	}

	/* The headline sharpens through Redaction's levels, noise to answer.
	   Starts only once every level has loaded (see script), so no fallback flash. */
	.resolve.is-resolving {
		animation: resolve 1100ms step-end 250ms both;
	}

	@keyframes resolve {
		0% { font-family: 'Redaction 100', serif; }
		20% { font-family: 'Redaction 70', serif; }
		40% { font-family: 'Redaction 50', serif; }
		60% { font-family: 'Redaction 35', serif; }
		80%, 100% { font-family: 'Redaction 20', serif; }
	}

	@media (prefers-reduced-motion: reduce) {
		.resolve.is-resolving {
			animation: none;
		}
	}

	/* Entrance */
	.hero-in {
		animation: hero-rise 900ms var(--ease-out) both;
		animation-delay: calc(var(--i, 0) * 90ms + 60ms);
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

