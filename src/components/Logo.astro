---
// The "◆ EULIX" mark from the chat UI's title bar, as a wordmark.
interface Props {
	href?: string;
}
const { href = import.meta.env.BASE_URL } = Astro.props;
---

<a class="logo" href={href} aria-label="Eulix home">
	<svg class="mark" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
		<rect x="3.2" y="3.2" width="9.6" height="9.6" rx="1.2" transform="rotate(45 8 8)" fill="currentColor"></rect>
	</svg>
	<span class="eulix" aria-hidden="true"><span class="r-0">E</span><span class="r-10">u</span><span class="r-50">l</span><span class="r-70">i</span><span class="r-100">x</span></span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		font-family: var(--font-mono);
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text);
		text-decoration: none;
	}
	.mark {
		color: var(--teal);
	}
</style>
