---
// Everything a page tells search engines and link previews: title, description,
// canonical URL, Open Graph, Twitter card, robots and JSON-LD. Rendered in
// <head> by layouts/Base.astro; pages set it through Base's props.
import { absoluteUrl, authorLd, graph } from '../lib/seo.ts';
import { SITE } from '../site.config.ts';

export interface Props {
	/** Page title without the site name. Omit on the home page. */
	title?: string;
	/** Use `title` as the whole <title>, without appending the site name. */
	rawTitle?: boolean;
	description?: string;
	type?: 'website' | 'article';
	/** Social preview image, relative to the site root. 1200×630 PNG. */
	image?: string;
	imageAlt?: string;
	/** Keep the page out of search results (and the sitemap filter). */
	noindex?: boolean;
	/** schema.org nodes for this page; the author node is added for you. */
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	rawTitle = false,
	description = SITE.description,
	type = 'website',
	image = 'og/eulix.png',
	imageAlt = `${SITE.name}: ${SITE.tagline}`,
	noindex = false,
	jsonLd = [],
} = Astro.props;

const fullTitle = !title ? `${SITE.name}: ${SITE.tagline}` : rawTitle ? title : `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const imageUrl = absoluteUrl(image);
// `<` is escaped so a string in the data can never close the script tag.
const ld = jsonLd.length ? JSON.stringify(graph([...jsonLd, authorLd()])).replace(/</g, '\\u003c') : undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{ld && <script type="application/ld+json" set:html={ld} />}
